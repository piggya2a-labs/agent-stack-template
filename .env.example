# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — found in Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Service role key — grants full DB access, never expose publicly
# Found in Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── LangGraph Cloud ───────────────────────────────────────────────────────────
# LangGraph Cloud deployment URL
# Found in LangSmith → Deployments → your deployment → URL
LANGGRAPH_URL=https://YOUR-ORG-HASH.us.langgraph.app

# LangSmith API key — authenticates all LangGraph API calls
# Found in LangSmith → Settings → API Keys
LANGSMITH_API_KEY=lsv2_pt_...

# ── GitHub ────────────────────────────────────────────────────────────────────
# GitHub Personal Access Token
# Required scopes: Issues (read & write), Contents (read)
# Create at: GitHub → Settings → Developer settings → Fine-grained tokens
GITHUB_TOKEN=github_pat_...

# ── Trigger.dev ───────────────────────────────────────────────────────────────
# Project reference — found in Trigger.dev → Project Settings
TRIGGER_PROJECT_REF=proj_...

# Secret key for local development
# Found in Trigger.dev → API Keys
TRIGGER_SECRET_KEY=tr_dev_...
